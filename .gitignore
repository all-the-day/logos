# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
desktop.ini

# eslint cache
.eslintcache

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/dev.db*
prisma/test.db*

# 归档/无用文件（不参与 git）
/archive/

# source databases
data/*.db*

# capacitor android（本地生成，不入库；APK 由 GitHub Actions 构建）
/android/
/builds/
*.keystore
*.jks

# 本地 Agent 配置（运维/规划文档，不入库）
/.codebuddy/
.codebuddy/
